#
# Adapted from GenPi64 work by Sakaki, which in turn followed
# Raspbian /etc/udev/rules.d/99-com.rules.

# ensure members of gpio group can read/write GPIO devices
# note: this replaces the old raspbian/sakaki sysfs /sys/class/gpio access method which is now obsolete

# raspberry pi-specific legacy gpiomem device
SUBSYSTEM=="bcm2835-gpiomem", GROUP="gpio", MODE="0660"

# modern gpio character devices used by libgpiod
#SUBSYSTEM=="gpio", GROUP="gpio", MODE="0660"   # modernized below to specifically address gpiochip
SUBSYSTEM=="gpio", KERNEL=="gpiochip*", GROUP="gpio", MODE="0660"
